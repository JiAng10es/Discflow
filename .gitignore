# ============================================================
#  Discflow .gitignore
#  原则：只提交源码、文档与截图。个人数据、构建产物、环境残留一律不入库。
# ============================================================

# ---------- 个人唱片资料库（绝不入库）----------
library/
*.wav
album.json
cover.png
cover.jpg

# ---------- 运行时生成 ----------
preferences.json

# ---------- 构建产物 ----------
*.exe
*.manifest
build/
dist/
__pycache__/
*.py[cod]
*.egg-info/

# ---------- 产品官网（单独部署到 GitHub Pages，不放进代码仓库）----------
website/

# ---------- AI 开发环境残留 ----------
.workbuddy-ai/
.workbuddy/
.agent/
.agents/
*.genie
README_WORKBUDDY.md
开发启动_WorkBuddy.bat
运行测试_WorkBuddy.bat

# ---------- 本地便捷脚本（含个人路径）----------
同步到E盘.bat

# ---------- 备份 ----------
_backup/
*.bak
*.bak_*

# ---------- 与播放器无关的残留 ----------
app.asar

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
